{
  "repo_id": "local/obstacle-reach-rl-v0",
  "default_root": "artifacts/obstacle-reach-seed-v0",
  "schema": "RGB camera1 + 6D joint state + language -> 3D joint-position action",
  "privileged_fields": ["target position", "obstacle position", "contacts"],
  "collection": {
    "expert": "damped least-squares with obstacle repulsion",
    "episodes": 20,
    "steps_per_episode": 80,
    "fps": 20,
    "seed": 1100,
    "task_balance": "alternating red_fast and green_smooth",
    "disturbance_step": 10
  },
  "splits": {
    "train_seeds": "1100-1115",
    "validation_seeds": "1116-1119",
    "evaluation_seeds": "2100-2103 (never demonstrations)"
  }
}
