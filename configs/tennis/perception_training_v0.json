{
  "model": "BallHeatmapDetector",
  "purpose": "M1 full-resolution ball-center detection before calibrated stereo triangulation",
  "production_dataset": "tennis-flight-v0",
  "image_size_px": [512, 384],
  "channels": 24,
  "epochs": 50,
  "batch_size": 32,
  "learning_rate": 0.001,
  "optimizer": "AdamW",
  "loss": "CenterNet-style focal heatmap loss with 256 per-image hard negatives",
  "checkpoint_selection": "validation pixel RMSE",
  "deployment_inputs": ["one RGB camera image"],
  "deployment_output": "ball-center pixel and confidence",
  "downsampling": false,
  "reason_for_no_downsampling": "the far ball can occupy one rendered pixel",
  "spatial_context": "full-resolution depthwise 5x5 convolution",
  "evaluation": {
    "stereo_detection_rate_minimum": 0.99,
    "position_rmse_m_maximum": 0.05,
    "contact_time_prediction_rate_minimum": 0.99,
    "contact_time_rmse_s_maximum": 0.025
  }
}
